# ============================================================
#  TRADING BOT — ENVIRONMENT VARIABLES
#  Rename this file to .env and fill in your keys
#  NEVER commit .env to GitHub
# ============================================================

# --- Alpaca Paper Trading (start here) ---
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Switch to these when going LIVE (after constitution is locked) ---
# ALPACA_BASE_URL=https://api.alpaca.markets

# --- News API (free at newsapi.org) ---
NEWS_API_KEY=your_newsapi_key_here

# --- Account capital ---
# Real money being tested for. Sizing and the kill switch use
# min(broker equity, ACCOUNT_CAPITAL), so a $100k paper account trades like
# this amount. Below $2,000 the bot also runs long-only with T+1 settlement.
ACCOUNT_CAPITAL=500

# --- Kill Switch ---
KILL_SWITCH_PCT=25

# --- Trading Mode ---
# Options: paper | live
TRADING_MODE=paper
